# Atlas — example environment configuration.
# Copy to `.env` and fill in locally. NEVER commit `.env` (see .gitignore / threat model).
# There are NO broker credentials here — Atlas has no execution capability until Phase 7,
# and broker keys will be trade-only when they exist (ADR 0009).

# --- Database (PostgreSQL) ---
# Placeholders only — never commit real credentials. Use a secret manager in production.
ATLAS_DB_URL=postgresql+psycopg://atlas_writer:__CHANGE_ME__@localhost:5432/atlas
# Least-privilege roles (ADR 0009 / migration 0002): the ingestion writer and the research
# reader are distinct DB roles. The reader is SELECT-only and can never mutate the truth.
ATLAS_DB_READONLY_URL=postgresql+psycopg://atlas_reader:__CHANGE_ME__@localhost:5432/atlas

# --- Object storage for immutable snapshots / raw payloads ---
# Local filesystem in dev; S3-compatible in prod. Abstracted behind atlas.data.snapshots.
ATLAS_STORAGE_BACKEND=local
ATLAS_STORAGE_ROOT=./data/local

# --- Environment ---
ATLAS_ENV=development            # development | test | production
ATLAS_LOG_LEVEL=INFO
ATLAS_TIMEZONE=Asia/Kolkata      # NSE trades in IST; never changed silently

# --- Data vendors (NOT wired in Phase 2; placeholders for later phases) ---
# Market-data integrity requires >=2 independent sources for capital-affecting data (ADR 0009).
# ATLAS_VENDOR_PRIMARY_API_KEY=
# ATLAS_VENDOR_SECONDARY_API_KEY=

# --- Test database (integration tests) ---
# Set to a throwaway Postgres URL to run @integration tests; unset => they skip.
# ATLAS_TEST_DB=postgresql+psycopg://atlas:atlas@localhost:5432/atlas_test
